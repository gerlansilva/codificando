{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codificando",
  "version": "0.2.4",
  "identifier": "br.com.gerlan.codificando",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codificando",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "COLE_AQUI_A_CHAVE_PUBLICA_DO_TAURI_SIGNER",
      "endpoints": [
        "https://github.com/SEU_USUARIO/codificando/releases/latest/download/latest.json"
      ]
    }
  }
}
