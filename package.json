{
  "name": "investigando",
  "productName": "Codificando",
  "version": "0.1.0",
  "description": "Codificando — análise qualitativa de dados. App desktop em Tauri.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app": "tauri dev",
    "start": "tauri build --config src-tauri/tauri.ci.conf.json && open src-tauri/target/release/bundle/macos/Codificando.app",
    "install:local": "bash scripts/install-local.sh",
    "sign:notarize": "bash scripts/sign-notarize.sh",
    "icon": "tauri icon src/assets/codificando-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "docx": "^9.16.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^31.0.1",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  }
}
